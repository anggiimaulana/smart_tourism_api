    {
      "name": "AI — Sentiment",
      "item": [
        {
          "name": "Summary All Wilayah",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sentiment/summary-all",
              "host": ["{{baseUrl}}"],
              "path": ["sentiment", "summary-all"]
            }
          },
          "response": []
        },
        {
          "name": "Summary Per Wilayah",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sentiment/summary/Indramayu?tipe_tempat=all",
              "host": ["{{baseUrl}}"],
              "path": ["sentiment", "summary", "Indramayu"],
              "query": [
                {
                  "key": "tipe_tempat",
                  "value": "all"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Sync All (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sentiment/sync-all",
              "host": ["{{baseUrl}}"],
              "path": ["sentiment", "sync-all"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "AI — Chatbot RAG",
      "item": [
        {
          "name": "Ask Chatbot",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message\": \"Rekomendasi pantai bagus di Indramayu apa ya?\",\n    \"session_token\": null,\n    \"latitude\": -6.3265,\n    \"longitude\": 108.3203\n}",
              "options": {
                "json": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chatbot/ask",
              "host": ["{{baseUrl}}"],
              "path": ["chatbot", "ask"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const token = res?.data?.session_token || res?.data?.data?.session_token;",
                  "if (token) {",
                  "  pm.collectionVariables.set('chatbotSessionToken', token);",
                  "  pm.environment.set('chatbotSessionToken', token);",
                  "  console.log('Saved chatbotSessionToken:', token);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chatbot/history/{{chatbotSessionToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["chatbot", "history", "{{chatbotSessionToken}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "AI — Recommendation",
      "item": [
        {
          "name": "Get Recommendation",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"latitude\": -6.3265,\n    \"longitude\": 108.3203,\n    \"limit\": 5\n}",
              "options": {
                "json": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/recommendation/",
              "host": ["{{baseUrl}}"],
              "path": ["recommendation", ""]
            }
          },
          "response": []
        },
        {
          "name": "Create Planning (Itinerary)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"wilayah\": [\"Indramayu\", \"Cirebon\"],\n    \"hari\": 3,\n    \"budget_total\": 1000000,\n    \"preferensi\": [\"Alam\", \"Kuliner\"],\n    \"judul\": \"Liburan Seru Ciayumajakuning\"\n}",
              "options": {
                "json": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/recommendation/planning",
              "host": ["{{baseUrl}}"],
              "path": ["recommendation", "planning"]
            }
          },
          "response": []
        }
      ]
    }
  ],
