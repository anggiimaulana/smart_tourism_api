# ============================================================
#  .env.example — Smart Tourism API
#  Salin file ini: cp .env.example .env
#  Lalu isi semua nilai di bawah ini.
#  JANGAN commit file .env ke GitHub!
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME=Smart Tourism Ciayumajakuning API
APP_VERSION=1.0.0
DEBUG=True  

# ── Database PostgreSQL ──────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/smart_tourism

# ── JWT Auth ─────────────────────────────────────────────────
# Generate random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_minimum_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── RAG Settings ─────────────────────────────────────────────
RAG_TOP_K=5
RAG_MIN_SCORE=0.05

# ── LLM Configuration (FALLBACK) ────────────────────────────
# LLM config utama sekarang dikelola dari Laravel Filament via tabel llm_configs.
# Setting di bawah ini hanya fallback jika tidak ada config aktif di database.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

LARAVEL_URL=https://backend.smart-tourism-citra.web.id